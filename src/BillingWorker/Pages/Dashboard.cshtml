@page "/dashboard"
@{
    ViewData["Title"] = "Monitor de jobs";
}
<!doctype html>
<html lang="pt-BR" class="bg-slate-950">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Billing Worker</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/flowbite@3.1.2/dist/flowbite.min.css" rel="stylesheet" />
</head>
<body class="min-h-screen bg-slate-950 text-slate-100">
    <main class="mx-auto max-w-6xl px-5 py-10 sm:px-8">
        <header class="mb-10 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
                <p class="mb-2 text-sm font-medium uppercase tracking-[0.2em] text-cyan-400">Billing Worker</p>
                <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Monitor de jobs</h1>
                <p class="mt-2 max-w-xl text-slate-400">Acompanhe o fechamento distribuído de faturas em tempo real.</p>
            </div>
            <div class="rounded-lg border border-slate-700 bg-slate-900 px-4 py-3 text-sm shadow-sm">
                <span class="text-slate-400">Atualização automática</span>
                <span class="ml-2 inline-flex items-center font-medium text-emerald-400"><span class="mr-2 h-2 w-2 rounded-full bg-emerald-400"></span>10 segundos</span>
            </div>
        </header>

        <section class="mb-6 grid gap-4 md:grid-cols-2 lg:grid-cols-4" aria-label="Status do job">
            <article class="rounded-xl border border-slate-800 bg-slate-900 p-5 shadow-lg shadow-black/10">
                <p class="text-sm font-medium text-slate-400">Status</p>
                <p id="job-status" class="mt-3 text-2xl font-bold text-slate-500">Carregando…</p>
            </article>
            <article class="rounded-xl border border-slate-800 bg-slate-900 p-5 shadow-lg shadow-black/10">
                <p class="text-sm font-medium text-slate-400">Última execução</p>
                <p id="last-run-at" class="mt-3 text-lg font-semibold text-white">—</p>
            </article>
            <article class="rounded-xl border border-slate-800 bg-slate-900 p-5 shadow-lg shadow-black/10">
                <p class="text-sm font-medium text-slate-400">Instância que executou</p>
                <p id="last-owner" class="mt-3 truncate font-mono text-lg font-semibold text-white">—</p>
            </article>
            <article class="rounded-xl border border-slate-800 bg-slate-900 p-5 shadow-lg shadow-black/10">
                <p class="text-sm font-medium text-slate-400">Faturas processadas</p>
                <p id="processed-items" class="mt-3 text-2xl font-bold text-white">—</p>
            </article>
        </section>

        <section class="rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-lg shadow-black/10" aria-labelledby="actions-title">
            <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-center">
                <div>
                    <h2 id="actions-title" class="text-lg font-semibold text-white">Ações</h2>
                    <p class="mt-1 text-sm text-slate-400">Os pedidos entram no job store compartilhado; qualquer réplica pode executá-los.</p>
                </div>
                <div class="flex flex-col gap-3 sm:flex-row">
                    <button id="seed-invoices" type="button" class="rounded-lg border border-slate-600 bg-slate-800 px-4 py-2.5 text-sm font-medium text-white hover:bg-slate-700 focus:outline-none focus:ring-4 focus:ring-slate-700">Criar faturas pendentes</button>
                    <button id="run-now" type="button" class="rounded-lg bg-cyan-500 px-4 py-2.5 text-sm font-semibold text-slate-950 hover:bg-cyan-400 focus:outline-none focus:ring-4 focus:ring-cyan-900">Executar agora</button>
                </div>
            </div>
            <div id="feedback" class="mt-5 hidden rounded-lg border px-4 py-3 text-sm" role="status" aria-live="polite"></div>
        </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/flowbite@3.1.2/dist/flowbite.min.js"></script>
    <script>
        const statusElement = document.getElementById('job-status');
        const feedback = document.getElementById('feedback');

        function showFeedback(message, isError = false) {
            feedback.textContent = message;
            feedback.className = `mt-5 rounded-lg border px-4 py-3 text-sm ${isError
                ? 'border-red-800 bg-red-950 text-red-300'
                : 'border-emerald-800 bg-emerald-950 text-emerald-300'}`;
        }

        function formatDate(value) {
            return value ? new Intl.DateTimeFormat('pt-BR', { dateStyle: 'medium', timeStyle: 'medium' }).format(new Date(value)) : 'Ainda não executado';
        }

        async function refreshStatus() {
            try {
                const response = await fetch('/jobs/billing-close/status');
                if (!response.ok) throw new Error();
                const job = await response.json();
                statusElement.textContent = job.lastStatus;
                statusElement.className = `mt-3 text-2xl font-bold ${job.lastStatus === 'SUCCESS' ? 'text-emerald-400' : job.lastStatus === 'FAILED' ? 'text-red-400' : 'text-amber-400'}`;
                document.getElementById('last-run-at').textContent = formatDate(job.lastRunAt);
                document.getElementById('last-owner').textContent = job.lastOwner ?? '—';
                document.getElementById('processed-items').textContent = job.processedItems;
            } catch {
                statusElement.textContent = 'Indisponível';
                statusElement.className = 'mt-3 text-2xl font-bold text-red-400';
            }
        }

        async function postAction(url, successMessage) {
            try {
                const response = await fetch(url, { method: 'POST' });
                if (!response.ok) throw new Error();
                showFeedback(successMessage);
                await refreshStatus();
            } catch {
                showFeedback('Não foi possível concluir a ação. Tente novamente.', true);
            }
        }

        document.getElementById('run-now').addEventListener('click', () => postAction('/jobs/billing-close/run-now', 'Job enviado para execução.'));
        document.getElementById('seed-invoices').addEventListener('click', () => postAction('/invoices/seed?count=25', '25 faturas pendentes foram criadas.'));
        refreshStatus();
        setInterval(refreshStatus, 10000);
    </script>
</body>
</html>
